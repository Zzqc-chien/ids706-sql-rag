# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - it must never be committed.

# Supabase project (Project Settings -> API Keys / Data API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<anon / publishable key - NOT the service_role / secret key>

# Postgres via the Session pooler (Connect -> Session pooler)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# Read-only role that runs quiz takers' SQL
DB_READER_USER=quiz_reader.<your-project-ref>
DB_READER_PASSWORD=<password you set for quiz_reader>

# App role that saves answers and writes the audit log
DB_APP_USER=quiz_app.<your-project-ref>
DB_APP_PASSWORD=<password you set for quiz_app>

# AI API (any OpenAI-compatible API)
# Duke AI Gateway: LLM_BASE_URL=https://litellm.oit.duke.edu/v1, key from https://dashboard.ai.duke.edu/api-keys
# OpenAI: leave LLM_BASE_URL empty
LLM_API_KEY=<your API key>
LLM_BASE_URL=https://litellm.oit.duke.edu/v1
LLM_MODEL=<a model name your key can use, e.g. gpt-4o-mini>
# Optional: models to try when LLM_MODEL hits its daily quota (comma separated)
LLM_FALLBACK_MODELS=

# Optional backup API, used when the main one is out of quota, overloaded or slow
# Groq (free, no card): key from https://console.groq.com/keys
LLM2_API_KEY=<backup API key>
LLM2_BASE_URL=https://api.groq.com/openai/v1
LLM2_MODEL=<a Groq model name, e.g. llama-3.3-70b-versatile>
